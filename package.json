{
  "name": "frontend-checkout-challenge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "npm run build -w @checkout/contracts && npm run dev -w @checkout/api",
    "build": "npm run build -w @checkout/contracts && npm run build -w @checkout/api",
    "start": "npm run start -w @checkout/api",
    "test": "npm run build && npm run test -w @checkout/api",
    "docs:generate": "npm run build && node scripts/openapi.mjs --write",
    "docs:check": "node scripts/openapi.mjs",
    "check": "npm run format:check && npm test && npm run check:web && npm run docs:check",
    "check:web": "npm run typecheck -w @checkout/web && npm run test -w @checkout/web && npm run build -w @checkout/web",
    "smoke": "node scripts/smoke.mjs",
    "data:reset": "node scripts/reset.mjs",
    "format": "biome check --write",
    "format:check": "biome check",
    "generate:api-types": "npm run generate:api-types -w @checkout/web",
    "prepare": "husky"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.0.0",
    "@biomejs/biome": "2.5.8",
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "husky": "9.1.7",
    "lint-staged": "16.2.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
